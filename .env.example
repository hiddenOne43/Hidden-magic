# Copiez ce fichier en .env pour le développement local.
# En production (Render), définissez ces variables dans le tableau de bord Render.
# NE JAMAIS commettre un vrai fichier .env dans le dépôt.

# URL de la base Turso (ex. libsql://hidden-magic-xxxx.turso.io)
# Laissez vide pour utiliser une base locale (fichier ./data/hidden-magic.db).
TURSO_DATABASE_URL=

# Jeton d'authentification Turso (créé avec `turso db tokens create <nom>`).
TURSO_AUTH_TOKEN=

# Secret utilisé pour signer les cookies de session.
# Générez une valeur longue et aléatoire, par exemple avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=changez-moi-par-une-valeur-aleatoire-longue

# Port d'écoute (Render définit PORT automatiquement).
PORT=3000
